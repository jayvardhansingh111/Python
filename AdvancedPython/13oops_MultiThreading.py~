lock=Lock()
def wish(name):
    with lock:
        for i in range(5):
            print("good evening:",end='')
            time.sleep(1)
            print(name)

t1=Thread(target=wish,args=("jay",))
t2=Thread(target=wish,args=("Anju",))
t3=Thread(target=wish,args=("shivani",))

